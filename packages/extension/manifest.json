{
  "manifest_version": 3,
  "name": "Lattice (M0)",
  "version": "0.5.0",
  "description": "An inspectable learner model — M0 skeleton",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "action": {
    "default_title": "Lattice"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/billboard.js", "content/sidebar.js", "content/ambient.js"],
      "css": ["content/sidebar.css", "content/ambient.css"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
